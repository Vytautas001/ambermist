#!/bin/bash
# Qwen3.8 startup is intentionally disabled until step 3 implements and tests
# the bootstrap, and the llama.cpp source commit is verified and pinned.
# This file exists so the step-2 OpenTofu plan can be reviewed offline.
# model: ${model_id} ${model_repository}@${model_revision}
# entry: ${model_entry_file}
# shards: ${jsonencode(model_shards)}
# total bytes: ${model_size_bytes}
# runtime: ${runtime_commit} ${build_image}@${build_digest}
# gpu: ${sku} sm${cuda_arch}; cmake: ${jsonencode(cmake_args)}
# placement provisional: ${placement_is_provisional}
# alias: ${alias}; sessions: ${sessions}
# weights mount: ${weights_mount}
# argv: ${jsonencode(argv)}
exit 1
