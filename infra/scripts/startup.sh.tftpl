#!/bin/bash
# =============================================================================
# ${project} — ${role}
# Rendered by Terraform. Runs once at first boot as root.
#
# SECURITY: this script body is stored in the Verda API in plaintext and is
# visible in Terraform state. It must contain NO secrets. Secrets are read from
# ${weights_mount}/.env, which an operator writes over SSH during phase p0 and
# which never leaves the encrypted volume.
# =============================================================================
set -euo pipefail

exec > >(tee -a /var/log/${project}-startup.log) 2>&1
echo "=== ${project} ${role} startup $(date -Is) ==="

ROLE="${role}"
MOUNT="${weights_mount}"
VLLM_IMAGE="${vllm_image}"
SERVED_NAME="${served_model_name}"
MODEL="${model}"
MAX_MODEL_LEN="${max_model_len}"
MAX_NUM_SEQS="${max_num_seqs}"
MAX_BATCHED_TOKENS="${max_batched_tokens}"
GPU_MEM_UTIL="${gpu_memory_util}"
TP="${tensor_parallel}"
NODE="${role}"

# -----------------------------------------------------------------------------
# 1. Wait for the shared weights volume.
#
# type = NVMe_Shared attaches as an NFS export (that's what makes it mountable
# by multiple instances at once - a real local NVMe block device can't do
# that), not a block device. verda_volume_attachment is applied AFTER the
# instance exists, and the export path is only known once that attachment
# completes, so it can't be baked into this script at render time. Poll for it
# at boot instead, the same way we'd poll for a block device.
#
# This used to discover the export path with `showmount -e` before mounting.
# Verda's NFS front end here answers on nfsd (2049) but drops portmapper
# (111) traffic instead of rejecting it - an NFSv4-only setup - so showmount
# doesn't fail fast, it hangs forever on a single attempt and silently
# defeats this loop's whole retry budget.
#
# The export name isn't just "${project}-weights" either - Verda appends an
# opaque per-attachment suffix ("${project}-weights-<id>") that isn't derivable
# from anything known at template-render time (checked: it's not the volume id
# or the instance id, it's assigned when the attachment is created, which is
# necessarily after this script is rendered - see the ordering note above).
# So discovery is still required, just not via portmapper: mount the server's
# NFSv4 pseudo-root (needs only nfsd/2049, same as the real mount) and read
# the export name off its directory listing instead of asking rpcbind for it.
# -----------------------------------------------------------------------------
mkdir -p "$MOUNT"

command -v mount.nfs >/dev/null 2>&1 || apt-get update -qq && apt-get install -qq -y nfs-common

NFS_SERVER="nfs.$(echo "${location}" | tr '[:upper:]' '[:lower:]').datacrunch.io"
PROBE="/mnt/.nfsroot-probe"
mkdir -p "$PROBE"

find_weights_export() {
  timeout 15 mount -t nfs -o vers=4 "$NFS_SERVER:/" "$PROBE" 2>/dev/null || return 1
  local name
  name="$(ls -1 "$PROBE" 2>/dev/null | grep -m1 "^${project}-weights")"
  umount "$PROBE" 2>/dev/null || true
  [[ -n "$name" ]] && echo "/$name"
}

EXPORT=""
for i in $(seq 1 60); do          # up to 10 minutes
  EXPORT="$(find_weights_export || true)"
  if [[ -n "$EXPORT" ]]; then
    echo "found weights export: $NFS_SERVER:$EXPORT (attempt $i)"
    break
  fi
  echo "waiting for weights volume attachment on $NFS_SERVER... ($i/60)"
  sleep 10
done

if [[ -z "$EXPORT" ]]; then
  echo "FATAL: weights volume export never appeared on $NFS_SERVER."
  echo "Check verda_volume_attachment.weights and mount manually:"
  echo "  tofu output -json mount_commands"
  exit 1
fi

mount -t nfs -o vers=4,nconnect=16 "$NFS_SERVER:$EXPORT" "$MOUNT" || { echo "FATAL: mount failed"; exit 1; }
grep -qxF "$NFS_SERVER:$EXPORT $MOUNT nfs defaults,vers=4,nconnect=16 0 0" /etc/fstab \
  || echo "$NFS_SERVER:$EXPORT $MOUNT nfs defaults,vers=4,nconnect=16 0 0" >> /etc/fstab
mkdir -p "$MOUNT/hf-cache" "$MOUNT/logs"
df -h "$MOUNT"

# -----------------------------------------------------------------------------
# 2. Secrets, from the volume — never from this script.
# -----------------------------------------------------------------------------
if [[ -f "$MOUNT/.env" ]]; then
  chmod 600 "$MOUNT/.env"
  # shellcheck disable=SC1091
  set -a; source "$MOUNT/.env"; set +a
  echo "loaded secrets from $MOUNT/.env"
else
  echo "WARNING: $MOUNT/.env not found."
  echo "Create it over SSH before serving:"
  echo "  printf 'HF_TOKEN=hf_xxx\nVLLM_API_KEY=xxx\n' | sudo tee $MOUNT/.env"
  echo "  sudo chmod 600 $MOUNT/.env"
fi

# -----------------------------------------------------------------------------
# 3. Sanity-check the GPU.
# -----------------------------------------------------------------------------
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv || {
  echo "FATAL: nvidia-smi failed — wrong image or driver not loaded"; exit 1; }

GPU_COUNT=$(nvidia-smi --list-gpus | wc -l)
echo "GPUs present: $GPU_COUNT, tensor-parallel-size: $TP"
if [[ "$GPU_COUNT" -ne "$TP" ]]; then
  echo "FATAL: instance has $GPU_COUNT GPU(s) but TP is $TP."
  echo "node_sku and node_tp disagree. Fix them together and re-apply."
  exit 1
fi

# -----------------------------------------------------------------------------
# 4. Pre-pull the vLLM image so a restart is fast.
# -----------------------------------------------------------------------------
docker pull "$VLLM_IMAGE"

%{ if !serve ~}
# -----------------------------------------------------------------------------
# BAKE PHASE (p0): download weights, do not serve.
# -----------------------------------------------------------------------------
echo "=== bake: pulling checkpoints to $MOUNT/hf-cache ==="
docker run --rm \
  -e HF_TOKEN="$${HF_TOKEN:-}" \
  -e HF_HOME=/weights/hf-cache \
  -v "$MOUNT:/weights" \
  --entrypoint /bin/bash "$VLLM_IMAGE" -c '
    set -e
    pip install -q "huggingface_hub[cli]"
    for repo in "'"$MODEL"'" ; do
      echo "--- downloading $repo"
      hf download "$repo" --cache-dir /weights/hf-cache
    done
  '
echo "=== bake complete. Verify with: du -sh $MOUNT/hf-cache/* ==="
exit 0
%{ else ~}

# -----------------------------------------------------------------------------
# 5. Serve. Flags follow the architecture design doc.
# -----------------------------------------------------------------------------
cat > /etc/systemd/system/${project}-vllm.service <<UNIT
[Unit]
Description=${project} vLLM (${role})
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=exec
Restart=always
RestartSec=20
TimeoutStartSec=1800
EnvironmentFile=-$MOUNT/.env
ExecStartPre=-/usr/bin/docker rm -f ${project}-vllm
ExecStart=/usr/bin/docker run --rm --name ${project}-vllm \\
  --gpus all --ipc=host --shm-size=16g --ulimit memlock=-1 --ulimit stack=67108864 \\
  -e NCCL_P2P_DISABLE=0 -e NCCL_SHM_DISABLE=0 \\
  -p 8000:8000 \\
  -v $MOUNT:/weights \\
  -e HF_HOME=/weights/hf-cache \\
  -e HF_TOKEN \\
  -e VLLM_API_KEY \\
  $VLLM_IMAGE \\
    --model $MODEL \\
    --served-model-name $SERVED_NAME \\
    --tensor-parallel-size $TP \\
    --max-model-len $MAX_MODEL_LEN \\
    --max-num-seqs $MAX_NUM_SEQS \\
    --max-num-batched-tokens $MAX_BATCHED_TOKENS \\
    --enable-chunked-prefill \\
    --enable-prefix-caching \\
    --kv-cache-dtype fp8 \\
    --gpu-memory-utilization $GPU_MEM_UTIL \\
    --swap-space 8 \\
    --reasoning-parser qwen3 \\
    --enable-auto-tool-choice \\
    --tool-call-parser hermes \\
    --max-cudagraph-capture-size 256 \\
    --host 0.0.0.0 --port 8000
ExecStop=/usr/bin/docker stop -t 60 ${project}-vllm

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now ${project}-vllm.service

# -----------------------------------------------------------------------------
# 6. Readiness probe. First start loads ~125GB of weights; be patient.
# -----------------------------------------------------------------------------
for i in $(seq 1 90); do
  if curl -fsS http://127.0.0.1:8000/health >/dev/null 2>&1; then
    echo "=== vLLM healthy after $((i*20))s ==="
    curl -s http://127.0.0.1:8000/v1/models || true
    exit 0
  fi
  sleep 20
done

echo "WARNING: vLLM not healthy after 30 minutes. Inspect with:"
echo "  journalctl -u ${project}-vllm.service -n 200 --no-pager"
%{ endif ~}
