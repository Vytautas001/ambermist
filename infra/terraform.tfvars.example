# cp terraform.tfvars.example terraform.tfvars and edit.
# terraform.tfvars is gitignored — it identifies your operators.

project  = "redcell"
location = "FIN-01"

ssh_public_keys = {
  # name => OpenSSH public key
  "vytautas"  = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... vyt@exercise"
  "whitecell" = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... wc@exercise"
}

# Confirm against your own account before the first apply: `make images`.
# Must be a "docker" category image (startup script requires Docker
# preinstalled); use the `image_type` slug, not the `id`.
image = "24.04.cuda12.9.docker"

weights_volume_size_gb = 400
os_volume_size_gb      = 100

budget_eur   = 500
eur_usd_rate = 1.1622
