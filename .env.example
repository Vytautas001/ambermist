# Copy to .env (gitignored) and fill in. Load with: set -a; source .env; set +a
# Never print or commit .env.

# --- Credentials ---
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=
HF_TOKEN=
# Bearer key clients send to llama-server: amb- + `openssl rand -hex 32`
AMB_API_KEY=
# Tailscale node auth key: reusable, ephemeral, pre-approved, tagged tag:ambermist, 90-day expiry.
# Note its expiry date here: TS_AUTHKEY expires YYYY-MM-DD
TS_AUTHKEY=

# --- SSH ---
# PRIVATE key file, used by ops/provision.sh and the tunnel command. Default: ~/.ssh/verda
SSH_KEY=$HOME/.ssh/verda

# --- Compute stack (OpenTofu reads TF_VAR_<name> as variable <name>) ---
TF_VAR_owner=your-name
# Only these addresses reach SSH (port 22). If your public IP is outside them, you lock yourself out.
TF_VAR_admin_cidrs='["193.219.12.0/23","188.69.0.0/17","88.118.128.0/17","85.206.0.0/18","78.56.0.0/14"]'
# Path to the PUBLIC key (the .pub file of SSH_KEY); OpenTofu reads the file itself.
TF_VAR_ssh_public_key_path=$HOME/.ssh/verda.pub
# Optional overrides:
# TF_VAR_use_spot=false
# TF_VAR_model_volume_size_gib=140  # ForceNew; see docs/inference-tier-plan.md §3.2 "Growing a volume"
