# cp .env.example .env — .env is gitignored and must never be committed.
# Load without printing: set -a; source .env; set +a
#
# .env holds credentials and per-deployment values, laid out in the order of the
# architecture (docs/ARCHITECTURE.md): provider -> weights -> serving replicas ->
# router -> harness. Model/runtime pins, context, and session limits do NOT
# belong here; they live in versioned deploy/ profiles (docs/MODEL-DEPLOYMENT-SPEC.md).
#
# Names marked "current" are what the existing code reads today. Names marked
# "target" are introduced by docs/IMPLEMENTATION-HANDOFF.md; until that work lands,
# set the current name as well. Never rename a current name without migrating its
# readers and the node file /mnt/weights/.env in the same change.

# --- Provider: Verda, Finland (OAuth2 client credentials, Verda console) ---
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=

# --- Model weights: Hugging Face ---
HF_TOKEN=

# --- Serving replicas: H200, H100, RTX PRO 6000 x2 (private network only) ---
# One key shared by every replica; also written to /mnt/weights/.env on each node.
# current name (ops/*.py, startup script, router):
VLLM_API_KEY=
# INFERENCE_API_KEY=     # target: runtime-neutral name; accept VLLM_API_KEY as a fallback
# SSH provisioning of node secrets (ops/provision_node_secrets.py)
# VLLM_SSH_USER=root
# VLLM_SSH_KEY=~/.ssh/id_ed25519
# Direct replica endpoints for the router. Current code reads NODE_A_URL/NODE_B_URL;
# target is one URL per independent replica (same artifact, same context).
NODE_A_URL=
NODE_B_URL=
# REPLICA_H200_URL=http://10.0.0.10:8000/v1
# REPLICA_H100_URL=
# REPLICA_RTX_A_URL=
# REPLICA_RTX_B_URL=

# --- Router: LiteLLM (see router/litellm.config.yaml) ---
LITELLM_MASTER_KEY=
# LITELLM_URL=http://router.exercise.local:4000   # used by router/issue-team-keys.sh
# LITELLM_DB=                                     # optional

# --- Harness: talks to the router, never to a replica directly ---
REDCELL_BASE_URL=http://router.exercise.local:4000/v1
REDCELL_API_KEY=
# Public aliases follow redcell-<model>. redcell-adversary is retired.
# REDCELL_MODEL=redcell-qwen38          # selected service
# rollback (explicit, never automatic): redcell-qwen35

# --- Per-team keys, issued by the router (router/issue-team-keys.sh) ---
# REDCELL_TEAM_KEY=sk-blue-team-01-...
