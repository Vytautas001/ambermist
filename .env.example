# cp .env.example .env   — .env is gitignored and must never be committed.

# --- Verda API (OAuth2 client credentials, from the Verda console) ---
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=

# --- Model weights ---
HF_TOKEN=

# --- Inference endpoint ---
# Direct vLLM node key; also install in /mnt/weights/.env on the node.
VLLM_API_KEY=
# The LiteLLM router, not a vLLM node directly.
REDCELL_BASE_URL=http://router.exercise.local:4000/v1
REDCELL_API_KEY=

# --- Per-team keys, issued by the router (see router/litellm.config.yaml) ---
# REDCELL_TEAM_KEY=sk-blue-team-01-...
